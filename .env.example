TMDB_API_KEY=your_tmdb_api_key_here
# Either of these enables startup auto-sync of your Letterboxd RSS feed:
LETTERBOXD_USERNAME=your_username_here
# Or, if you'd rather point directly at the RSS feed URL:
# LETTERBOXD_RSS_CLIENT_ID=https://letterboxd.com/your_username/rss/

# Local pgvector database (started with Docker Compose)
POSTGRES_DB=movie_recommender
POSTGRES_USER=movie_recommender
POSTGRES_PASSWORD=local_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
